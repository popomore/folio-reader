{
  "schema": 1,
  "unit": "folio",
  "type": "assets",
  "branch": "main",
  "tag_prefix": "v",
  "auto_on_main": true,
  "base_version": "0.1.1",
  "paths": [
    ".github/workflows/ci.yml",
    ".github/workflows/release-macos.yml",
    ".release/**",
    "apps/macos/**",
    "crates/**",
    "renderer/**",
    "scripts/**",
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    ".node-version"
  ],
  "versioning": "semantic-release",
  "prerelease": "preview",
  "preview_tag_compatibility": "timestamp"
}
