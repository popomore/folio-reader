#!/usr/bin/env bash
set -euo pipefail
umask 077

directory=$(mktemp -d "$RUNNER_TEMP/folio-signing.XXXXXX")
previous=$(security list-keychains -d user)
keychain="$directory/signing.keychain-db"
cleanup() {
  security delete-keychain "$keychain" >/dev/null 2>&1 || true
  rm -rf "$directory"
}
trap cleanup EXIT
printf '%s' "${FOLIO_APPLE_CERTIFICATE:?}" | base64 -D > "$directory/certificate.p12"
password=$(openssl rand -hex 24)
security create-keychain -p "$password" "$keychain"
security unlock-keychain -p "$password" "$keychain"
python3 - "$keychain" "$previous" <<'PY'
import shlex, subprocess, sys
subprocess.run(["security", "list-keychains", "-d", "user", "-s", sys.argv[1], *shlex.split(sys.argv[2])], check=True)
PY
security import "$directory/certificate.p12" -f pkcs12 -k "$keychain" -P "${FOLIO_APPLE_CERTIFICATE_PASSWORD:?}" -T /usr/bin/codesign
security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k "$password" "$keychain"
export FOLIO_SIGNING_KEYCHAIN="$keychain"
FOLIO_APPLE_SIGNING_IDENTITY=$(security find-identity -v -p codesigning "$keychain" | sed -n 's/.*"\(Developer ID Application: .*\)"/\1/p')
export FOLIO_APPLE_SIGNING_IDENTITY
scripts/package-macos-release
