{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chuome-folio-site-test",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "env": {
    "test": {
      "name": "chuome-folio-site-test",
      "workers_dev": true,
      "assets": { "directory": "./dist", "not_found_handling": "404-page" }
    },
    "production": {
      "name": "chuome-folio-site",
      "workers_dev": false,
      "routes": [{ "pattern": "folio.chuo.me", "custom_domain": true }],
      "assets": { "directory": "./dist", "not_found_handling": "404-page" }
    }
  }
}
